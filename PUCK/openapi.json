 "components": {
  "schemas": {
   "Circuit": {
    "properties": {
     "num_qubits": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Num Qubits"
     },
     "num_clbits": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 64.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Num Clbits"
     },
     "gates": {
      "items": {
       "$ref": "#/components/schemas/Operation"
      },
      "type": "array",
      "maxItems": 10000,
      "title": "Gates"
     },
     "measure_all": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Measure All"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "num_qubits"
    ],
    "title": "Circuit",
    "description": "Quantum Puck circuit schema v1 (see docs/circuit-schema.md)."
   },
   "ErrorInfo": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "op_index": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Op Index"
     },
     "line": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Line"
     }
    },
    "type": "object",
    "required": [
     "code",
     "message"
    ],
    "title": "ErrorInfo"
   },
   "Experiment": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Name"
     },
     "description": {
      "type": "string",
      "maxLength": 4000,
      "title": "Description",
      "default": ""
     },
     "circuit": {
      "$ref": "#/components/schemas/Circuit"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 16,
      "title": "Tags"
     },
     "last_job_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Job Id"
     },
     "id": {
      "type": "string",
      "title": "Id"
     },
     "created_at": {
      "type": "number",
      "title": "Created At"
     },
     "updated_at": {
      "type": "number",
      "title": "Updated At"
     },
     "last_result": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Result"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "name",
     "circuit",
     "id",
     "created_at",
     "updated_at"
    ],
    "title": "Experiment"
   },
   "ExperimentIn": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Name"
     },
     "description": {
      "type": "string",
      "maxLength": 4000,
      "title": "Description",
      "default": ""
     },
     "circuit": {
      "$ref": "#/components/schemas/Circuit"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 16,
      "title": "Tags"
     },
     "last_job_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Job Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "name",
     "circuit"
    ],
    "title": "ExperimentIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "JobInfo": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "queued",
       "running",
       "completed",
       "failed",
       "cancelled"
      ],
      "title": "Status"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Name"
     },
     "backend": {
      "type": "string",
      "title": "Backend"
     },
     "shots": {
      "type": "integer",
      "title": "Shots"
     },
     "num_qubits": {
      "type": "integer",
      "title": "Num Qubits"
     },
     "created_at": {
      "type": "number",
      "title": "Created At"
     },
     "started_at": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Started At"
     },
     "finished_at": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished At"
     },
     "queue_position": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
